rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'gamesPlayed', 'gamesWon']) &&
             data.keys().hasOnly(['uid', 'displayName', 'avatar', 'gamesPlayed', 'gamesWon', 'winStreak', 'createdAt', 'email']) &&
             data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.gamesPlayed is number && data.gamesPlayed >= 0 &&
             data.gamesWon is number && data.gamesWon >= 0 &&
             (!('winStreak' in data) || (data.winStreak is number && data.winStreak >= 0)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 10)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100));
    }

    // Validation Blueprint for Completed Match Records
    function isValidMatchRecord(data) {
      return data.keys().hasAll(['matchId', 'winnerName', 'winnerColor', 'mode']) &&
             data.keys().hasOnly(['matchId', 'winnerName', 'winnerColor', 'mode', 'totalRolls', 'durationSeconds', 'completedAt']) &&
             data.matchId is string && data.matchId.size() >= 1 && data.matchId.size() <= 64 &&
             data.winnerName is string && data.winnerName.size() >= 1 && data.winnerName.size() <= 50 &&
             data.winnerColor is string && data.winnerColor.size() <= 20 &&
             data.mode is string && data.mode.size() <= 20 &&
             (!('totalRolls' in data) || data.totalRolls is number) &&
             (!('durationSeconds' in data) || data.durationSeconds is number) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 60));
    }

    // Connection validation probe path
    match /test/{testDoc} {
      allow read: if true;
    }

    // User profiles & stats (Restricted to authenticated owner)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Multiplayer Game Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isValidId(roomId) && isSignedIn() && incoming().hostId == request.auth.uid;
      allow update: if isValidId(roomId) && isSignedIn();
      allow delete: if isValidId(roomId) && isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    // Completed Match Archives (Append-only by authenticated players, immutable)
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isValidId(matchId) && isSignedIn() && isValidMatchRecord(incoming());
      allow update, delete: if false;
    }
  }
}
